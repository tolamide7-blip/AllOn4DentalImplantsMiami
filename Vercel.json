                 <div className="bg-surface border border-border p-8 rounded-2xl shadow-xl">
                    <h4 className="font-bold text-sm mb-6 flex items-center gap-2 uppercase font-space tracking-widest">
                       <Scale size={18} className="text-primary" /> Insurance Leverage
                    </h4>
                    <div className="space-y-4">
                       <div className="flex items-start gap-3">
                          <div className="mt-1"><ChevronRight size={14} className="text-primary"/></div>
                          <p className="text-xs text-secondaryText leading-relaxed">Ask your adjuster specifically about the <b>Chassis Rail Gapping</b> noted in the scan DNA.</p>
                       </div>
                       <div className="flex items-start gap-3">
